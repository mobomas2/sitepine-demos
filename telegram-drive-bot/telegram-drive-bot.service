# نمونه سرویس systemd برای اجرای دائمی روی سرور لینوکسی.
# نصب:
#   sudo cp telegram-drive-bot.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now telegram-drive-bot
#   journalctl -u telegram-drive-bot -f
[Unit]
Description=Telegram to Google Drive bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/telegram-drive-bot
ExecStart=/opt/telegram-drive-bot/.venv/bin/python bot.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
