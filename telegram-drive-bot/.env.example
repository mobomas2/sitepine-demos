# ---------- تلگرام ----------
# توکنی که از @BotFather گرفتی
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- گوگل درایو ----------
# آیدی پوشه‌ای که همه‌چیز باید داخلش برود (از URL پوشه درایو کپی کن)
DRIVE_FOLDER_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz012345

# راه اول (پیشنهادی برای اکانت شخصی Gmail): OAuth2
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx
GOOGLE_REFRESH_TOKEN=

# راه دوم (فقط Google Workspace / Shared Drive): سرویس‌اکانت
# اگر این را پر کنی، سه مقدار بالا نادیده گرفته می‌شوند.
GOOGLE_SERVICE_ACCOUNT_FILE=

# ---------- رفتار ربات ----------
# فقط این یوزرآی‌دی‌ها اجازه دارند (با کاما جدا کن). خالی = همه می‌توانند آپلود کنند.
# آیدی خودت را با /id از ربات بگیر.
ALLOWED_USER_IDS=

# ساخت زیرپوشه بر اساس تاریخ داخل پوشه اصلی: date | none
SUBFOLDER_MODE=date

# متن‌ها چطور ذخیره شوند: doc = گوگل داک | txt = فایل متنی ساده
TEXT_MODE=doc

# حداکثر حجم فایل برای دانلود (مگابایت). سقف Bot API تلگرام ۲۰ است.
MAX_UPLOAD_MB=19

# منطقه زمانی برای نام پوشه‌ها و فایل‌ها
TZ=Asia/Tehran
